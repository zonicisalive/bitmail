# ==============================================================================
# Bitmail - Enterprise Mass Email & Storage Platform Configuration
# ==============================================================================

# Application Environment (development | production)
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Application Branding & Server Bind
APP_NAME=Bitmail Enterprise Mass Email & Storage Platform
HOST=0.0.0.0
PORT=8000

# Base URL used for Open/Click Tracking, Unsubscribe Links & QR Auth
# (Must match your public domain, e.g. https://sender.bitnade.com)
TRACKING_BASE_URL=https://sender.bitnade.com

# Default Sender Identity
DEFAULT_SENDER_NAME=Zonic
DEFAULT_SENDER_EMAIL=zonic@bitnade.com

# Company & Compliance Information (Injected into email footers)
COMPANY_NAME=Bitnade
COMPANY_ADDRESS=Bitnade Inc., 100 Pine Street, San Francisco, CA
PRIVACY_POLICY_URL=https://bitnade.com/privacy

# Security & Secret Key
# IMPORTANT: Generate a strong secret key for production (e.g. openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production

# Default Administrative Credentials
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@bitnade.com
DEFAULT_ADMIN_PASSWORD=admin123

# Database & Storage Directories (Optional overrides)
# DATA_DIR=/path/to/data
# DATABASE_PATH=/path/to/data/mass_email.db
# STORAGE_DIR=/path/to/storage
# EML_STORAGE_DIR=/path/to/storage/eml

# Dispatch & Performance Tuning
# DEFAULT_RATE_LIMIT_PER_SEC=25
# MAX_CONCURRENT_SENDS=10
# SMTP_CONNECTION_TIMEOUT_SECONDS=30
