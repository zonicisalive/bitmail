# ==============================================================================
# Bitmail Enterprise Mass Email System - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your secure secrets.
# NEVER commit your actual .env file or production secrets to Git!
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Server Bind Configuration
HOST=0.0.0.0
PORT=8000

# Base URL used for email open/click tracking & unsubscribe links
TRACKING_BASE_URL=http://localhost:8000

# Mandatory Cryptographic Secret Key for JWT sessions & Fernet encryption
# In production, generate a secure random 64-character hex key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=insecure-dev-only-secret-key-change-in-production

# Default Initial Administrator Credentials
# In production, specify a secure custom email and strong password
DEFAULT_ADMIN_EMAIL=admin@bitmail.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-to-a-strong-password

# Database & Vault Storage Paths (Relative to repository root or absolute)
DATA_DIR=data
DATABASE_PATH=data/mass_email.db
STORAGE_DIR=storage
EML_STORAGE_DIR=storage/eml
EML_ARCHIVE_DIR=data/eml_archive
STORE_RAW_EML_FILES=true

# Default Sender Identity
DEFAULT_SENDER_NAME="Bitmail Team"
DEFAULT_SENDER_EMAIL=team@bitmail.io

# Company & Compliance
COMPANY_NAME="Bitmail Technologies Inc."
COMPANY_ADDRESS="100 Market St, Suite 500, San Francisco, CA 94105"
PRIVACY_POLICY_URL=http://localhost:8000/privacy
